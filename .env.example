# --- Supabase ---
# Crea un proyecto en https://supabase.com/dashboard y copia estos dos valores
# desde:  Project Settings  ->  Data API  (o "API")  ->  Project URL / Project API Keys
#
# NEXT_PUBLIC_SUPABASE_URL      = "Project URL"        (ej: https://abcdefgh.supabase.co)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "anon" / "public" / "publishable" key (clave publica, segura para el browser)
#
# Ambas son publicas (van al cliente). La RLS es lo que protege tus datos, NO la ocultacion de la anon key.
# NUNCA pongas aqui la "service_role" key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
